# Wowrack Recruitment API - Environment Variables Example
# Duplicate this file to .env and fill in the actual values.

# --- Database (PostgreSQL) ---
# Use 'db' as host if running with docker-compose, otherwise use 'localhost' or your remote IP
DB_HOST=db
# Port is 5432
DB_PORT=5432
# Database User
DB_USER=postgres
# Database Password
DB_PASSWORD=recruitpass
# Database Name
DB_NAME=recruitment
# SSL Mode (disable for development)
DB_SSLMODE=disable

# --- Object Storage (MinIO) ---
# Use 'minio:9000' as endpoint if running with docker-compose, otherwise use 'localhost:9000'
S3_ENDPOINT=minio:9000
# User defined in docker-compose.yml
S3_ACCESS_KEY=admin
# Password defined in docker-compose.yml
S3_SECRET_KEY=password123
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true
# Buckets to be used
S3_BUCKET_PROFILES=profiles
S3_BUCKET_NEWS=news
S3_BUCKET_APPLICATIONS=applications
S3_BUCKET_JOBS=jobs

# --- Server ---
# Port the API will listen on
PORT=8080
# Enable Swagger UI (set to false in production)
ENABLE_SWAGGER=true
# Secret key for signing JWT tokens (MUST BE 32+ CHARS)
JWT_SECRET=rahasia-sangat-rahasia-wowrack-2025-min-32-char

# --- Email (Optional, used for notifications) ---
EMAIL_FROM=example@gmail.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_PASSWORD=your_app_password_here

# --- Admin Setup (Optional) ---
# Enable this temporarily to create the first admin user
ENABLE_SETUP_ENDPOINT=true
SETUP_SECRET=mysecretpassword
